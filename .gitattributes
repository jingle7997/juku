# 统一换行符，避免 Windows 检出后 shell 脚本带 CRLF 在 Docker / macOS 里执行失败
* text=auto

*.sh        text eol=lf
*.command   text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

*.bat       text eol=crlf
*.cmd       text eol=crlf

*.png       binary
*.jpg       binary
*.ipa       binary
*.exe       binary
